# LLM Provider selection: 'ollama' (free local) or 'gemini' (cloud)
LLM_PROVIDER=ollama
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# App Settings
MAX_RESULT_ROWS=500
SQL_RETRY_LIMIT=1
LOG_DB_PATH=./agent_runs.db
